# --- Сервер ---
PORT=4000
NODE_ENV=development
WEB_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5177,http://127.0.0.1:4173

# --- PostgreSQL ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/restaurant?schema=public"

# --- JWT и сессии ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# --- Коды на почту ---
CODE_SECRET=change-me-another-long-random-string
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
# true — код возвращается в ответе API и печатается в консоль (только для разработки)
DEV_RETURN_CODES=true

# --- SMTP (Gmail: пароль приложения, не пароль от аккаунта) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Maison Lumière <no-reply@maison-lumiere.ru>"
